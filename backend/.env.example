# ============================================
# OPEN SOURCE CONTRIBUTION ATELIER
# Backend environment configuration
# ============================================
# Copy this file to backend/.env (never commit the real .env).
# Settings are read in backend/config/settings.py, which loads backend/.env
# with python-dotenv. Variables already set in your shell or in
# docker-compose.yml win over the values in .env.
#
# Part 1 is what you need to look at to run the backend locally.
# Part 2 is optional: each block says what happens when it is left blank.
# Setup problems? See docs/TROUBLESHOOTING_SETUP.md.


# ############################################
# PART 1: REQUIRED FOR LOCAL DEV
# ############################################

# ============ APPLICATION ============
# Only the exact string "True" turns debug mode on. Anything else is False.
# DEBUG=True also allows every CORS origin and lets session cookies work over
# plain http://localhost. Use False in production.
DEBUG=True

# development | production. The server refuses to start when
# DEBUG=True and DJANGO_ENV=production.
DJANGO_ENV=development

# Django signing key. If the variable is missing, a built-in insecure dev key
# is used. If it is set but empty, startup fails with ImproperlyConfigured.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-secure-key-at-least-32-bytes-long

# NOTE: settings.py currently hardcodes ALLOWED_HOSTS = ["*"], so this value
# is not read by the backend right now.
ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app

# ============ DATABASE ============
# Django reads only DATABASE_URL for its database.
# Left commented: the backend uses a local SQLite file (backend/db.sqlite3),
# which is fine for local work. Uncomment it only when Postgres is running.
# If it points at a Postgres that is not running, startup hangs or fails
# while connecting (the plugins app touches the database on startup).
# DATABASE_URL=postgresql://contribution_atelier:secure_password_here@localhost:5432/contribution_atelier

# ============ REDIS ============
# Blank: the backend still tries redis://127.0.0.1:6379/0.
# If Redis is not reachable, Channels uses InMemoryChannelLayer and the cache
# uses LocMemCache. Rate limiting only uses Redis when REDIS_URL is set and
# reachable, otherwise it uses the "local" backend.
# Everything works in one process; multi-worker realtime needs Redis.
REDIS_URL=redis://localhost:6379/0
# Skip Redis detection and force the in-memory path (handy for local dev):
# FORCE_INMEMORY_CHANNEL_LAYER=1

# ============ CORS & FRONTEND ============
# Comma-separated, each origin needs http:// or https://. With DEBUG=False a
# wildcard or malformed origin stops startup. http://localhost:5173 and
# http://127.0.0.1:5173 are always allowed.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Added to the CORS list automatically and used to build links in emails and
# billing redirects. Default: http://localhost:5173
FRONTEND_URL=http://localhost:5173


# ############################################
# PART 2: OPTIONAL, BY FEATURE
# ############################################

# ============ TOKEN LIFETIMES ============
# Read by SimpleJWT in settings.py, in days.
# Defaults: 30 days access, 365 days refresh.
# ACCESS_TOKEN_LIFETIME_DAYS=30
REFRESH_TOKEN_LIFETIME_DAYS=7
# NOTE: ACCESS_TOKEN_LIFETIME_MINUTES, JWT_ACCESS_TOKEN_LIFETIME and
# JWT_REFRESH_TOKEN_LIFETIME used to be listed here, but nothing applies them
# to tokens, so they were removed.

# ============ GITHUB OAUTH (Sign in with GitHub) ============
# Create an OAuth app: https://github.com/settings/developers
# Blank: GitHub login returns "GitHub OAuth is not configured."; email and
# Google login still work.
# (The old GITHUB_OAUTH_CLIENT_ID / GITHUB_OAUTH_CLIENT_SECRET names are
# still accepted as deprecated aliases and win over these two if set.)
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# ============ GOOGLE OAUTH (Sign in with Google) ============
# Only override these when you use your own Google OAuth client.
# GOOGLE_CLIENT_ID defaults to the client ID baked into the frontend
# (VITE_GOOGLE_CLIENT_ID). Both sides must match or ID-token audience
# verification rejects the login.
# GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
# Required only for VITE_GOOGLE_OAUTH_FLOW=auth-code (authorization-code
# exchange). The default implicit / access-token flow needs no secret.
# GOOGLE_CLIENT_SECRET=

# ============ GITHUB APP (repo and webhook integration) ============
# Create a GitHub App: https://github.com/settings/apps
# Blank: the GitHub App client (backend/github/auth.py) raises "not
# configured" when used. The rest of the app is unaffected.
GITHUB_APP_ID=your_actual_app_id
GITHUB_INSTALLATION_ID=your_actual_installation_id
GITHUB_WEBHOOK_SECRET=your_webhook_secret
# Path to the App's private key .pem file (needed together with GITHUB_APP_ID):
# GITHUB_PRIVATE_KEY_PATH=
# Personal access token for GitHub API calls. Blank: requests go out
# unauthenticated and hit GitHub's low rate limit sooner.
# GITHUB_TOKEN=

# ============ STRIPE (billing) ============
# Blank: checkout and subscription changes run in mock mode, they are
# applied locally and no request goes to Stripe.
# NOTE: settings.py reads these before it loads .env, so right now they only
# take effect when set in your shell / host environment, not in this file.
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# ============ EMAIL ============
# Default is the console backend: emails are printed to the terminal, nothing
# is sent. That is what you want in dev.
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# DEFAULT_FROM_EMAIL=noreply@atelier.dev
# NOTE: EMAIL_HOST, EMAIL_PORT, EMAIL_HOST_USER and EMAIL_HOST_PASSWORD used
# to be listed here, but settings.py does not read them from the environment
# yet, so they were removed. Setting them alone does not switch on SMTP.

# ============ WEB PUSH (VAPID) ============
# Generate keys: https://web-push-codelab.glitch.me/
# Blank: push notifications are skipped (the push channel logs
# "VAPID_PRIVATE_KEY not configured" and mocks the send). In-app
# notifications still work.
# NOTE: the notification code reads VAPID_PRIVATE_KEY and VAPID_ADMIN_EMAIL
# from Django settings, and settings.py does not load them from the
# environment yet, so for now push stays mocked even with these set.
# The old WEB_PUSH_PRIVATE_KEY / WEB_PUSH_PUBLIC_KEY were not read anywhere
# and were removed.
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_ADMIN_EMAIL=mailto:admin@yourdomain.com

# ============ DATABASE BACKUPS (scripts/backup_db.py) ============
# Only the backup script reads the DB_* group below (verify_backup uses them
# as a fallback). Django itself uses DATABASE_URL, so skip these unless you
# run backups. backup_db.py exits with an error if DB_NAME, DB_USER,
# DB_PASSWORD or DB_HOST is missing.
DB_NAME=contribution_atelier
DB_USER=contribution_atelier
DB_PASSWORD=secure_password_here
DB_HOST=localhost
DB_PORT=5432

# Directory the scheduled backup tasks in apps/core/tasks.py write to
# (default: backend/backups/). Keep it commented to get the default: an
# empty BACKUP_DIR= means the current working directory instead.
# backup_db.py always writes to backend/backups/ and ignores this.
# BACKUP_DIR=
# Days to keep backup files before pruning (default: 30)
BACKUP_RETENTION_DAYS=30

# ============ AWS S3 (backup upload) ============
# Read by scripts/backup_db.py and the verify_backup command.
# Blank bucket: backups stay on local disk and the S3 upload is skipped.
# Bucket set but keys missing: upload is skipped with a warning.
# (These replace AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY and
# S3_BACKUP_BUCKET, which the code never read.)
S3_BUCKET_NAME=your-backup-bucket-name
S3_ACCESS_KEY=your_aws_access_key
S3_SECRET_KEY=your_aws_secret_key
AWS_REGION=us-east-1

# ============ OPTIONAL READ REPLICA ============
# Dedicated replica for analytics/reporting queries.
# DB_REPLICA_HOST blank: no dedicated replica, reads use the primary.
# The other DB_REPLICA_* values are only used when DB_REPLICA_HOST is set.
DB_REPLICA_HOST=
DB_REPLICA_PORT=5432
DB_REPLICA_NAME=contribution_atelier
DB_REPLICA_USER=contribution_atelier
DB_REPLICA_PASSWORD=
DB_REPLICA_ENGINE=django.db.backends.postgresql

# ============ AI TUTOR ============
# Get a key from https://platform.openai.com/api-keys
# Blank: the AI tutor falls back to rule-based responses.
OPENAI_API_KEY=
# Model used when a key is set (default: gpt-3.5-turbo)
LLM_MODEL=gpt-3.5-turbo

# ============ SENTRY ============
# Blank: Sentry error tracking is disabled.
SENTRY_DSN=
# Fraction of requests traced when SENTRY_DSN is set (default: 1.0)
SENTRY_TRACES_SAMPLE_RATE=1.0
