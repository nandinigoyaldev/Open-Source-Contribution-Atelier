{
  "comment": "Performance budget thresholds. The bundle and lighthouse sections are enforced in CI (.github/workflows/performance-budget.yml), api and database are targets only. See docs/frontend/PERFORMANCE_BUDGET.md.",
  "bundle": {
    "totalJsGzipKB": 3500,
    "singleChunkMaxKB": 1000,
    "totalCssGzipKB": 100,
    "reviewThresholdPct": 90
  },
  "lighthouse": {
    "performance": 50,
    "accessibility": 85,
    "bestPractices": 90,
    "seo": 90,
    "largestContentfulPaintMs": 10000,
    "cumulativeLayoutShift": 0.1,
    "interactiveMs": 12000
  },
  "api": {
    "endpoints": [
      {
        "path": "/api/content/lessons/",
        "p95Ms": 500,
        "maxDegradationPct": 20
      },
      { "path": "/api/dashboard/", "p95Ms": 500, "maxDegradationPct": 20 },
      { "path": "/api/leaderboard/", "p95Ms": 500, "maxDegradationPct": 20 },
      { "path": "/api/auth/me/", "p95Ms": 200, "maxDegradationPct": 20 },
      { "path": "/api/progress/", "p95Ms": 500, "maxDegradationPct": 20 }
    ]
  },
  "database": {
    "maxQueriesPerPageLoad": 50,
    "nPlusOneDetection": true
  }
}
